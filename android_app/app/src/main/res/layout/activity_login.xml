<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rtk_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="55dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTK DEVIL"
            android:textColor="@color/rtk_green"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIKE TAXI"
            android:textColor="@color/rtk_text"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.20"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aapki ride, aapke gaon se"
            android:textColor="@color/rtk_muted"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp"
            android:layout_marginTop="38dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textColor="@color/rtk_text"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apne account mein login karein"
                android:textColor="@color/rtk_muted"
                android:textSize="14sp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="22dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingHorizontal="15dp"
                android:textColor="@color/rtk_text"
                android:textColorHint="@color/rtk_muted"
                android:background="@drawable/bg_input"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingHorizontal="15dp"
                android:textColor="@color/rtk_text"
                android:textColorHint="@color/rtk_muted"
                android:background="@drawable/bg_input"
                android:layout_marginTop="14dp"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="LOGIN"
                android:textStyle="bold"
                android:textColor="#101411"
                android:background="@drawable/bg_primary_button"
                android:layout_marginTop="24dp"/>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="CREATE NEW ACCOUNT"
                android:textColor="@color/rtk_text"
                android:background="@drawable/bg_secondary_button"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOMER  •  RIDER  •  LOCAL MOBILITY"
            android:textColor="@color/rtk_muted"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="28dp"/>

    </LinearLayout>
</ScrollView>
